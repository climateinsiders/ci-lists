# Site
SITE_URL=https://lists.climateinsiders.com

# Supabase (VC Boom project). Same values as the vcboom Vercel project.
SUPABASE_URL=https://qzhstjaakmvcmnmrdvbi.supabase.co
SUPABASE_SECRET_KEY=

# Stripe: the VC Boom account. Same STRIPE_SECRET_KEY as the vcboom project.
# STRIPE_WEBHOOK_SECRET is NEW: it comes from the new webhook endpoint for this site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_live_... / pk_test_...) of the same account. Turns on the in-page checkout; leave empty to redirect to Stripe's hosted page.
