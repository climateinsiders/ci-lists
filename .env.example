# Site
SITE_URL=https://lists.climateinsiders.com

# Supabase (VC Boom project). Same values as the vcboom Vercel project.
SUPABASE_URL=https://qzhstjaakmvcmnmrdvbi.supabase.co
SUPABASE_SECRET_KEY=

# Stripe: the VC Boom account. Same STRIPE_SECRET_KEY as the vcboom project.
# STRIPE_WEBHOOK_SECRET is NEW: it comes from the new webhook endpoint for this site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_live_... / pk_test_...) of the same account. Turns on the in-page checkout; leave empty to redirect to Stripe's hosted page.
STRIPE_PUBLISHABLE_KEY=

# Resend: same key as the vcboom project. Sends from climateinsiders.com (verify the domain in Resend first).
RESEND_API_KEY=
EMAIL_FROM=Yoann Berno <yoann@climateinsiders.com>
EMAIL_REPLY_TO=yoann@climateinsiders.com

# Any long random string. Vercel sends it to /api/cron-emails as a Bearer token.
CRON_SECRET=

# Grand slam offer ($390): where the buyer lands after paying. Shown on /welcome, only for a paid upsell session.
# Any link left empty shows "arriving by email" instead of a button.
DATABASE_URL=
OUTREACH_KIT_URL=
FUNDRAISING_KIT_URL=
NEWSLETTER_URL=

# Airtable: writes investor signups from /join into base appLZFv8yLM6DmF4V,
# table "Climate Insiders - Investor Community". Reuse the SAME personal access
# token already in the claude-fundraiser project rather than minting another
# one, but widen its scopes: it currently only has read. It needs
# data.records:write, and schema.bases:write if fields are to be added by API.
AIRTABLE_API_KEY=

# Website forms: set to on to send the day 2 and day 5 follow-up emails (confirmation always sends).
CI_FOLLOWUPS=off
