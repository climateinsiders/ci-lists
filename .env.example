# Resend: same key as the vcboom project. Sends from climateinsiders.com (verify the domain in Resend first).
RESEND_API_KEY=
EMAIL_FROM=Yoann Berno <yoann@climateinsiders.com>
EMAIL_REPLY_TO=yoann@climateinsiders.com

# Any long random string. Vercel sends it to /api/cron-emails as a Bearer token.
CRON_SECRET=

# Grand slam offer ($390): where the buyer lands after paying. Shown on /welcome, only for a paid upsell session.
# Any link left empty shows "arriving by email" instead of a button.
DATABASE_URL=
OUTREACH_KIT_URL=
FUNDRAISING_KIT_URL=
